generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
  deleted
}

enum OrgStatus {
  trial
  active
  suspended
  closed
}

enum MembershipRole {
  owner
  admin
  member
}

enum EventType {
  meetup
  conference
  workshop
  exhibition
  festival
  corporate
  sports
  webinar
  hybrid
}

enum EventStatus {
  draft
  published
  cancelled
  completed
  archived
}

enum EventVisibility {
  public
  unlisted
  private
}

enum AttendanceMode {
  in_person
  virtual
  hybrid
}

enum MediaStatus {
  pending
  ready
  failed
}

enum RegistrationMode {
  open_free
  open_paid
  rsvp
}

enum TicketTypeVisibility {
  public
  hidden
}

enum RegistrationStatus {
  started
  pending_payment
  pending_approval
  confirmed
  waitlisted
  rejected
  cancelled
  expired
}

enum RegistrationSource {
  web
  import
  onsite
  invite
}

enum OrderStatus {
  created
  pending
  paid
  failed
  refunded
  partially_refunded
  expired
}

enum PaymentStatus {
  created
  authorized
  captured
  failed
  refunded
}

enum AttendeeStatus {
  registered
  checked_in
  no_show
  cancelled
}

enum CredentialStatus {
  active
  revoked
  expired
  superseded
}

enum EventStaffRole {
  checkin
  registration
  manager
}

enum CheckInResult {
  ok
  already
  invalid
  revoked
  wrong_event
  denied
}

enum RefundStatus {
  pending
  processed
  failed
}

model User {
  id               String     @id @default(cuid())
  email            String?    @unique
  phone            String?    @unique
  emailVerifiedAt  DateTime?  @map("email_verified_at")
  phoneVerifiedAt  DateTime?  @map("phone_verified_at")
  name             String?
  avatarMediaId    String?    @map("avatar_media_id")
  locale           String     @default("en-IN")
  timezone         String     @default("Asia/Kolkata")
  status           UserStatus @default(active)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  memberships      Membership[]
  sessions         Session[]
  magicLinkTokens  MagicLinkToken[]
  otpCodes         OtpCode[]
  auditLogs        AuditLog[]       @relation("AuditActor")
  createdEvents    Event[]          @relation("EventCreator")
  eventStaff       EventStaff[]
  checkIns         CheckIn[]        @relation("CheckInStaff")

  @@index([status])
  @@map("users")
}

model Organization {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  logoMediaId      String?   @map("logo_media_id")
  primaryColor     String?   @map("primary_color")
  supportEmail     String?   @map("support_email")
  supportPhone     String?   @map("support_phone")
  gstin            String?
  billingAddress   Json?     @map("billing_address")
  country          String    @default("IN")
  timezone         String    @default("Asia/Kolkata")
  status           OrgStatus @default(active)
  razorpayKeyId    String?   @map("razorpay_key_id")
  razorpayKeySecret String?  @map("razorpay_key_secret")
  customSubdomain   String?  @unique @map("custom_subdomain")
  ssoEnabled        Boolean  @default(false) @map("sso_enabled")
  ssoProvider       String?  @map("sso_provider")
  createdAt        DateTime  @default(now()) @map("created_at")

  memberships Membership[]
  events      Event[]
  media       Media[]
  auditLogs   AuditLog[]
  apiKeys     ApiKey[]
  webhooks    WebhookEndpoint[]

  @@map("organizations")
}

model Membership {
  id         String         @id @default(cuid())
  orgId      String         @map("org_id")
  userId     String         @map("user_id")
  role       MembershipRole
  invitedBy  String?        @map("invited_by")
  acceptedAt DateTime?      @map("accepted_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("magic_link_tokens")
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  phone     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@map("otp_codes")
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?  @map("org_id")
  actorId    String?  @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actor User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Media {
  id           String      @id @default(cuid())
  orgId        String      @map("org_id")
  filename     String
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  storageKey   String      @map("storage_key")
  status       MediaStatus @default(pending)
  uploadedById String?     @map("uploaded_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("media")
}

model Event {
  id              String          @id @default(cuid())
  orgId           String          @map("org_id")
  title           String
  slug            String
  publicSlug      String?         @unique @map("public_slug")
  type            EventType       @default(workshop)
  status          EventStatus     @default(draft)
  visibility      EventVisibility @default(public)
  description     String?
  timezone        String          @default("Asia/Kolkata")
  startsAt        DateTime?       @map("starts_at")
  endsAt          DateTime?       @map("ends_at")
  venueName       String?         @map("venue_name")
  venueAddress    String?         @map("venue_address")
  city            String?
  category        String?
  tags            String[]        @default([])
  capacity        Int?
  currency        String          @default("INR")
  modules         Json            @default("{}")
  attendanceModes AttendanceMode[] @map("attendance_modes")
  coverMediaId    String?         @map("cover_media_id")
  createdById     String?         @map("created_by")
  publishedAt     DateTime?       @map("published_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  registrationFormSchema Json?            @map("registration_form_schema")
  registrationMode       RegistrationMode @default(open_free) @map("registration_mode")

  org            Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy      User?            @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  site           EventSite?
  analytics      AnalyticsEvent[]
  ticketTypes    TicketType[]
  registrations  Registration[]
  attendees      Attendee[]
  orders         Order[]
  eventStaff     EventStaff[]
  checkIns       CheckIn[]
  tracks         EventTrack[]
  eventSessions  EventSession[]
  speakers       Speaker[]
  sponsors       Sponsor[]
  sponsorTiers   SponsorTier[]
  exhibitors     Exhibitor[]
  streams        Stream[]
  messageTemplates MessageTemplate[]
  surveyResponses SurveyResponse[]
  networkingProfiles NetworkingProfile[]

  @@unique([orgId, slug])
  @@index([orgId, startsAt])
  @@index([status, startsAt])
  @@index([status, visibility, startsAt])
  @@map("events")
}

model EventSite {
  id               String @id @default(cuid())
  eventId          String @unique @map("event_id")
  templateId       String @default("conference") @map("template_id")
  theme            Json   @default("{}")
  sections         Json   @default("[]")
  seo              Json   @default("{}")
  publishedVersion Int    @default(0) @map("published_version")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_sites")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  orgId     String?  @map("org_id")
  eventId   String?  @map("event_id")
  userId    String?  @map("user_id")
  sessionId String?  @map("session_id")
  properties Json?
  createdAt DateTime @default(now()) @map("created_at")

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([orgId, createdAt])
  @@index([eventId, createdAt])
  @@map("analytics_events")
}

model TicketType {
  id             String               @id @default(cuid())
  eventId        String               @map("event_id")
  orgId          String               @map("org_id")
  name           String
  description    String?
  priceCents     Int                  @default(0) @map("price_cents")
  currency       String               @default("INR")
  quantity       Int?
  soldCount      Int                  @default(0) @map("sold_count")
  salesStartsAt  DateTime?            @map("sales_starts_at")
  salesEndsAt    DateTime?            @map("sales_ends_at")
  visibility     TicketTypeVisibility @default(public)
  accessCode     String?              @map("access_code")
  sortOrder      Int                  @default(0) @map("sort_order")
  isActive       Boolean              @default(true) @map("is_active")
  mode           RegistrationMode     @default(open_free)
  formSchema     Json?                @map("form_schema")
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inventoryHolds  InventoryHold[]
  registrations   Registration[]
  attendees       Attendee[]

  @@index([eventId, sortOrder])
  @@map("ticket_types")
}

model InventoryHold {
  id           String   @id @default(cuid())
  ticketTypeId String   @map("ticket_type_id")
  qty          Int      @default(1)
  expiresAt    DateTime @map("expires_at")
  orderId      String?  @map("order_id")
  sessionId    String?  @map("session_id")
  registrationId String? @map("registration_id")
  createdAt    DateTime @default(now()) @map("created_at")

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([ticketTypeId])
  @@index([expiresAt])
  @@map("inventory_holds")
}

model Registration {
  id           String             @id @default(cuid())
  eventId      String             @map("event_id")
  orgId        String             @map("org_id")
  ticketTypeId String             @map("ticket_type_id")
  orderId      String?            @map("order_id")
  status       RegistrationStatus @default(started)
  source       RegistrationSource @default(web)
  answers      Json               @default("{}")
  utm          Json?
  startedAt    DateTime           @default(now()) @map("started_at")
  confirmedAt  DateTime?          @map("confirmed_at")
  cancelledAt  DateTime?          @map("cancelled_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  attendee   Attendee?
  consents   ConsentRecord[]

  @@index([eventId, status])
  @@index([eventId, createdAt])
  @@index([orderId])
  @@map("registrations")
}

model Order {
  id              String      @id @default(cuid())
  eventId         String      @map("event_id")
  orgId           String      @map("org_id")
  buyerEmail      String      @map("buyer_email")
  buyerPhone      String?     @map("buyer_phone")
  buyerName       String?     @map("buyer_name")
  status          OrderStatus @default(created)
  subtotalCents   Int         @default(0) @map("subtotal_cents")
  discountCents   Int         @default(0) @map("discount_cents")
  taxCents        Int         @default(0) @map("tax_cents")
  feeCents        Int         @default(0) @map("fee_cents")
  totalCents      Int         @default(0) @map("total_cents")
  currency        String      @default("INR")
  couponId        String?     @map("coupon_id")
  provider        String      @default("razorpay")
  providerOrderId String?     @unique @map("provider_order_id")
  gstinBuyer      String?     @map("gstin_buyer")
  gstinSeller     String?     @map("gstin_seller")
  taxBreakup      Json?       @map("tax_breakup")
  expiresAt       DateTime?   @map("expires_at")
  paidAt          DateTime?   @map("paid_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  event            Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations    Registration[]
  inventoryHolds   InventoryHold[]
  payments         Payment[]
  refunds          Refund[]

  @@index([eventId, status])
  @@map("orders")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @map("order_id")
  provider          String        @default("razorpay")
  providerPaymentId String        @unique @map("provider_payment_id")
  status            PaymentStatus @default(created)
  amountCents       Int           @map("amount_cents")
  method            String?
  rawLastPayload    Json?         @map("raw_last_payload")
  createdAt         DateTime      @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String       @map("order_id")
  paymentId        String       @map("payment_id")
  amountCents      Int          @map("amount_cents")
  reason           String?
  status           RefundStatus @default(pending)
  providerRefundId String?      @unique @map("provider_refund_id")
  createdById      String?      @map("created_by")
  createdAt        DateTime     @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("refunds")
}

model Attendee {
  id             String         @id @default(cuid())
  eventId        String         @map("event_id")
  orgId          String         @map("org_id")
  registrationId String         @unique @map("registration_id")
  ticketTypeId   String         @map("ticket_type_id")
  userId         String?        @map("user_id")
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String
  phone          String?
  company        String?
  jobTitle       String?        @map("job_title")
  category       String?
  attendanceMode AttendanceMode @default(in_person) @map("attendance_mode")
  nfcUid         String?        @map("nfc_uid")
  status         AttendeeStatus @default(registered)
  answers        Json           @default("{}")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  credential   Credential?
  ticketToken  TicketToken?
  checkIns     CheckIn[]

  @@index([eventId, email])
  @@index([eventId, phone])
  @@index([eventId, lastName])
  @@index([eventId, status])
  @@map("attendees")
}

model Credential {
  id           String           @id @default(cuid())
  attendeeId   String           @unique @map("attendee_id")
  eventId      String           @map("event_id")
  publicId     String           @unique @map("public_id")
  secretHash   String           @map("secret_hash")
  kind         String           @default("qr")
  status       CredentialStatus @default(active)
  issuedAt     DateTime         @default(now()) @map("issued_at")
  revokedAt    DateTime?        @map("revoked_at")
  revokeReason String?          @map("revoke_reason")

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  checkIns CheckIn[]

  @@index([eventId, status])
  @@map("credentials")
}

model TicketToken {
  id         String    @id @default(cuid())
  attendeeId String    @unique @map("attendee_id")
  token      String    @unique
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@map("ticket_tokens")
}

model EventStaff {
  id         String         @id @default(cuid())
  eventId    String         @map("event_id")
  orgId      String         @map("org_id")
  userId     String?        @map("user_id")
  phone      String
  name       String?
  role       EventStaffRole @default(checkin)
  invitedAt  DateTime       @default(now()) @map("invited_at")
  acceptedAt DateTime?      @map("accepted_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, phone])
  @@index([userId])
  @@map("event_staff")
}

model CheckIn {
  id             String        @id @default(cuid())
  eventId        String        @map("event_id")
  attendeeId     String        @map("attendee_id")
  credentialId   String        @map("credential_id")
  location       String        @default("gate")
  locationId     String?       @map("location_id")
  stationId      String?       @map("station_id")
  staffUserId    String?       @map("staff_user_id")
  result         CheckInResult
  offlineId      String?       @unique @map("offline_id")
  idempotencyKey String?       @unique @map("idempotency_key")
  isManual       Boolean       @default(false) @map("is_manual")
  scannedAt      DateTime      @default(now()) @map("scanned_at")
  syncedAt       DateTime?     @map("synced_at")

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee   Attendee   @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  staffUser  User?      @relation("CheckInStaff", fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([eventId, scannedAt])
  @@index([attendeeId])
  @@index([credentialId, location])
  @@map("check_ins")
}

model ConsentRecord {
  id             String   @id @default(cuid())
  registrationId String   @map("registration_id")
  kind           String
  version        String
  accepted       Boolean
  acceptedAt     DateTime @default(now()) @map("accepted_at")
  ip             String?

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@map("consent_records")
}

model Coupon {
  id              String   @id @default(cuid())
  eventId         String   @map("event_id")
  code            String
  type            String
  value           Int
  maxRedemptions  Int?     @map("max_redemptions")
  redeemed        Int      @default(0)
  minOrderCents   Int?     @map("min_order_cents")
  ticketTypeIds   String[] @map("ticket_type_ids")
  startsAt        DateTime? @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([eventId, code])
  @@map("coupons")
}

enum MessageChannel {
  email
  sms
}

model MessageTemplate {
  id        String         @id @default(cuid())
  eventId   String?        @map("event_id")
  orgId     String         @map("org_id")
  trigger   String
  channel   MessageChannel @default(email)
  subject   String?
  bodyHtml  String         @map("body_html")
  bodyText  String?        @map("body_text")
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, trigger, channel])
  @@index([orgId])
  @@map("message_templates")
}

model SurveyResponse {
  id         String   @id @default(cuid())
  eventId    String   @map("event_id")
  attendeeId String?  @map("attendee_id")
  answers    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("survey_responses")
}

model EventTrack {
  id        String @id @default(cuid())
  eventId   String @map("event_id")
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions EventSession[]

  @@index([eventId])
  @@map("tracks")
}

model EventSession {
  id          String    @id @default(cuid())
  eventId     String    @map("event_id")
  trackId     String?   @map("track_id")
  title       String
  description String?
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  room        String?
  sortOrder   Int       @default(0) @map("sort_order")

  event    Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  track    EventTrack?      @relation(fields: [trackId], references: [id], onDelete: SetNull)
  speakers SessionSpeaker[]
  saves    SessionSave[]

  @@index([eventId, startsAt])
  @@map("event_sessions")
}

model Speaker {
  id        String  @id @default(cuid())
  eventId   String  @map("event_id")
  name      String
  title     String?
  company   String?
  bio       String?
  photoUrl  String? @map("photo_url")
  sortOrder Int     @default(0) @map("sort_order")

  event    Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions SessionSpeaker[]

  @@index([eventId])
  @@map("speakers")
}

model SessionSpeaker {
  sessionId String @map("session_id")
  speakerId String @map("speaker_id")

  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker Speaker      @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([sessionId, speakerId])
  @@map("session_speakers")
}

model SessionSave {
  id         String @id @default(cuid())
  sessionId  String @map("session_id")
  attendeeId String @map("attendee_id")

  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, attendeeId])
  @@map("session_saves")
}

model NetworkingProfile {
  id         String  @id @default(cuid())
  eventId    String  @map("event_id")
  attendeeId String  @unique @map("attendee_id")
  headline   String?
  interests  String[] @default([])
  visible    Boolean @default(true)
  connectCode String @unique @map("connect_code")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, visible])
  @@map("networking_profiles")
}

enum ConnectionStatus {
  pending
  accepted
  declined
}

model ConnectionRequest {
  id          String           @id @default(cuid())
  eventId     String           @map("event_id")
  fromAttendeeId String        @map("from_attendee_id")
  toAttendeeId   String        @map("to_attendee_id")
  status      ConnectionStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([eventId, fromAttendeeId, toAttendeeId])
  @@map("connection_requests")
}

model SponsorTier {
  id        String @id @default(cuid())
  eventId   String @map("event_id")
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsors Sponsor[]

  @@index([eventId])
  @@map("sponsor_tiers")
}

model Sponsor {
  id        String  @id @default(cuid())
  eventId   String  @map("event_id")
  tierId    String? @map("tier_id")
  name      String
  logoUrl   String? @map("logo_url")
  website   String?
  sortOrder Int     @default(0) @map("sort_order")

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tier  SponsorTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("sponsors")
}

model Exhibitor {
  id           String @id @default(cuid())
  eventId      String @map("event_id")
  orgId        String @map("org_id")
  name         String
  description  String?
  boothNumber  String? @map("booth_number")
  logoUrl      String? @map("logo_url")
  passQuota    Int     @default(5) @map("pass_quota")
  contactEmail String? @map("contact_email")

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leads Lead[]

  @@index([eventId])
  @@map("exhibitors")
}

model Lead {
  id          String   @id @default(cuid())
  exhibitorId String   @map("exhibitor_id")
  attendeeId  String   @map("attendee_id")
  eventId     String   @map("event_id")
  notes       String?
  scannedAt   DateTime @default(now()) @map("scanned_at")

  exhibitor Exhibitor @relation(fields: [exhibitorId], references: [id], onDelete: Cascade)

  @@unique([exhibitorId, attendeeId])
  @@index([exhibitorId])
  @@map("leads")
}

model Stream {
  id          String  @id @default(cuid())
  eventId     String  @map("event_id")
  title       String
  embedUrl    String  @map("embed_url")
  provider    String  @default("mux")
  isLive      Boolean @default(false) @map("is_live")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("streams")
}

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String    @map("org_id")
  name       String
  keyHash    String    @unique @map("key_hash")
  keyPrefix  String    @map("key_prefix")
  scopes     String[]  @default([])
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("api_keys")
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  url       String
  secret    String
  events    String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("webhook_endpoints")
}

model BadgeTemplate {
  id        String @id @default(cuid())
  eventId   String @unique @map("event_id")
  layout    Json   @default("{}")
  zplTemplate String? @map("zpl_template")

  @@map("badge_templates")
}
