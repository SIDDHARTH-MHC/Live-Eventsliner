generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
  deleted
}

enum OrgStatus {
  trial
  active
  suspended
  closed
}

enum MembershipRole {
  owner
  admin
  member
}

enum EventType {
  meetup
  conference
  workshop
  exhibition
  festival
  corporate
  sports
  webinar
  hybrid
}

enum EventStatus {
  draft
  published
  cancelled
  completed
  archived
}

enum EventVisibility {
  public
  unlisted
  private
}

enum AttendanceMode {
  in_person
  virtual
  hybrid
}

enum MediaStatus {
  pending
  ready
  failed
}

model User {
  id               String     @id @default(cuid())
  email            String?    @unique
  phone            String?    @unique
  emailVerifiedAt  DateTime?  @map("email_verified_at")
  phoneVerifiedAt  DateTime?  @map("phone_verified_at")
  name             String?
  avatarMediaId    String?    @map("avatar_media_id")
  locale           String     @default("en-IN")
  timezone         String     @default("Asia/Kolkata")
  status           UserStatus @default(active)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  memberships      Membership[]
  sessions         Session[]
  magicLinkTokens  MagicLinkToken[]
  otpCodes         OtpCode[]
  auditLogs        AuditLog[]       @relation("AuditActor")
  createdEvents    Event[]          @relation("EventCreator")

  @@index([status])
  @@map("users")
}

model Organization {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  logoMediaId    String?   @map("logo_media_id")
  primaryColor   String?   @map("primary_color")
  supportEmail   String?   @map("support_email")
  supportPhone   String?   @map("support_phone")
  gstin          String?
  billingAddress Json?     @map("billing_address")
  country        String    @default("IN")
  timezone       String    @default("Asia/Kolkata")
  status         OrgStatus @default(active)
  createdAt      DateTime  @default(now()) @map("created_at")

  memberships Membership[]
  events      Event[]
  media       Media[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Membership {
  id         String         @id @default(cuid())
  orgId      String         @map("org_id")
  userId     String         @map("user_id")
  role       MembershipRole
  invitedBy  String?        @map("invited_by")
  acceptedAt DateTime?      @map("accepted_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("magic_link_tokens")
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  phone     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@map("otp_codes")
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?  @map("org_id")
  actorId    String?  @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actor User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Media {
  id           String      @id @default(cuid())
  orgId        String      @map("org_id")
  filename     String
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  storageKey   String      @map("storage_key")
  status       MediaStatus @default(pending)
  uploadedById String?     @map("uploaded_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("media")
}

model Event {
  id              String          @id @default(cuid())
  orgId           String          @map("org_id")
  title           String
  slug            String
  publicSlug      String?         @unique @map("public_slug")
  type            EventType       @default(workshop)
  status          EventStatus     @default(draft)
  visibility      EventVisibility @default(public)
  description     String?
  timezone        String          @default("Asia/Kolkata")
  startsAt        DateTime?       @map("starts_at")
  endsAt          DateTime?       @map("ends_at")
  venueName       String?         @map("venue_name")
  venueAddress    String?         @map("venue_address")
  city            String?
  capacity        Int?
  currency        String          @default("INR")
  modules         Json            @default("{}")
  attendanceModes AttendanceMode[] @map("attendance_modes")
  coverMediaId    String?         @map("cover_media_id")
  createdById     String?         @map("created_by")
  publishedAt     DateTime?       @map("published_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  site      EventSite?
  analytics AnalyticsEvent[]

  @@unique([orgId, slug])
  @@index([orgId, startsAt])
  @@index([status, startsAt])
  @@index([status, visibility, startsAt])
  @@map("events")
}

model EventSite {
  id               String @id @default(cuid())
  eventId          String @unique @map("event_id")
  templateId       String @default("conference") @map("template_id")
  theme            Json   @default("{}")
  sections         Json   @default("[]")
  seo              Json   @default("{}")
  publishedVersion Int    @default(0) @map("published_version")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_sites")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  orgId     String?  @map("org_id")
  eventId   String?  @map("event_id")
  userId    String?  @map("user_id")
  sessionId String?  @map("session_id")
  properties Json?
  createdAt DateTime @default(now()) @map("created_at")

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([orgId, createdAt])
  @@index([eventId, createdAt])
  @@map("analytics_events")
}
