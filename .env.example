# App
NODE_ENV=development
PORT=43123
APP_URL=http://localhost:43123
SESSION_SECRET=change-me-to-a-long-random-string-in-production

# Database (Postgres)
DATABASE_URL=postgresql://eventsliner:eventsliner@localhost:5432/eventsliner?schema=public

# Redis (sessions, OTP cooldown, rate limits)
REDIS_URL=redis://localhost:6379

# Email (Resend — use console provider in dev when unset)
RESEND_API_KEY=
EMAIL_FROM=noreply@eventsliner.live

# SMS (MSG91 — use console provider in dev when unset)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=EVTLIN

# Object storage (S3-compatible — MinIO/R2/AWS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=eventsliner
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/eventsliner

# Sentry (optional)
SENTRY_DSN=
