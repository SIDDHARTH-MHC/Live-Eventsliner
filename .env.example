# App
NODE_ENV=development
PORT=43123
APP_URL=http://localhost:43123
SESSION_SECRET=change-me-to-a-long-random-string-in-production

# Database (Postgres)
DATABASE_URL=postgresql://eventsliner:eventsliner@localhost:5432/eventsliner?schema=public

# Redis (sessions, OTP cooldown, rate limits)
REDIS_URL=redis://localhost:6379

# Email (Resend — use console provider in dev when unset)
RESEND_API_KEY=
EMAIL_FROM=Eventsliner Live <noreply@eventsliner.live>

# SMS (MSG91 — use console provider in dev when unset)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=EVTLIN

# Object storage (S3-compatible — MinIO/R2/AWS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=eventsliner
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/eventsliner

# Sentry (optional)
SENTRY_DSN=

# Razorpay (optional — mock provider used when unset; org-level keys override in settings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cron sweeper (optional in dev)
CRON_SECRET=

# SSO (Phase 17 — WorkOS optional)
SSO_ENABLED=false
SSO_PROVIDER=workos
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# WhatsApp BSP (Phase 8 — Gupshup/Interakt)
GUPSHUP_API_KEY=
GUPSHUP_SOURCE_NUMBER=
WHATSAPP_BSP_API_KEY=
WHATSAPP_SOURCE_NUMBER=
WHATSAPP_TEMPLATE_REGISTRATION=registration_confirmed

# Video streaming (Phase 15 — Mux/Daily optional)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
DAILY_API_KEY=
MOCK_STREAM_URL=https://www.youtube.com/embed/dQw4w9WgXcQ

# Allowed origins for CSRF (comma-separated, optional)
ALLOWED_ORIGINS=

# Identity partners (Phase 20 — opt-in enterprise only; never build Aadhaar/FR)
IDFY_API_KEY=
HYPERVERGE_API_KEY=

# Flutter Mode B white-label build factory (Codemagic / GitHub Actions webhook)
EVENT_APP_BUILD_WEBHOOK_URL=
EVENT_APP_BUILD_WEBHOOK_SECRET=
