# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
dump.rdb
*.rdb

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel
*vck_*

# typescript
*.tsbuildinfo
next-env.d.ts
agent-tools/

# Flutter (apps/*)
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
apps/**/ios/Flutter/ephemeral/
apps/**/ios/Flutter/Generated.xcconfig
apps/**/ios/Flutter/flutter_export_environment.sh
apps/eventsliner_event_app/.flutter-plugins-dependencies
apps/eventsliner_event_app/build/
